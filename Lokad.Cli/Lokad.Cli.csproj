<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <LangVersion>11.0</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable Condition="'$(Configuration)'=='Release'">true</IsPackable>
        <IsPackable Condition="'$(Configuration)'!='Release'">false</IsPackable>
        <GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">true</GeneratePackageOnBuild>
        <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCliGeneratorInPackage</TargetsForTfmSpecificContentInPackage>
        <_CliGeneratorPackageFramework>$(TargetFrameworks.Split(';').GetValue(0))</_CliGeneratorPackageFramework>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageIcon>lokad.png</PackageIcon>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Readme.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="..\lokad.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lokad.Cli.Generator\Lokad.Cli.Generator.csproj"
                          PrivateAssets="all"
                          OutputItemType="CliGeneratorOutput"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- The generator is shared by all target frameworks; include it only once. -->
    <Target Name="IncludeCliGeneratorInPackage"
            DependsOnTargets="ResolveProjectReferences"
            Condition="'$(TargetFramework)' == '$(_CliGeneratorPackageFramework)'">
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(CliGeneratorOutput)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>
